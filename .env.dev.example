NODE_ENV=development
PUBLIC_APP_URL=http://localhost
API_PORT=3001
WEB_ORIGIN=http://localhost
POSTGRES_PORT=5432
REDIS_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
WEB_PORT=80
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
INGESTION_KEY_PEPPER=replace-with-an-independent-random-secret
# Alert channel secret key (kid:base64 of 32 random bytes, e.g. "dev:" + `openssl rand -base64 32`).
LENS_ALERT_SECRET_KEY=replace-with-kid-and-base64-of-32-random-bytes
OIDC_ENABLED=false
PASSWORD_LOGIN_ENABLED=true
OTLP_MAX_BODY_BYTES=10485760
OTLP_RATE_LIMIT_PER_MINUTE=600
MCP_RATE_LIMIT_PER_MINUTE=120
