# Image release. Pin this to a published Lens version for repeatable deployments.
LENS_VERSION=latest

# Host directory that stores Docker volumes. Check with:
# docker info --format '{{.DockerRootDir}}'
SYSTEM_MONITOR_DATA_PATH=/var/lib/docker
LENS_PULL_POLICY=always
# LENS_BACKEND_IMAGE=ghcr.io/anvia-hq/lens
# LENS_WEB_IMAGE=ghcr.io/anvia-hq/lens-web

# Browser-facing origin. Put Lens behind an HTTPS reverse proxy for internet deployments.
PUBLIC_APP_URL=https://lens.example.com
WEB_ORIGIN=https://lens.example.com
WEB_PORT=80

# Generate URL-safe values, for example with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-value
CLICKHOUSE_PASSWORD=replace-with-a-random-hex-value
REDIS_PASSWORD=replace-with-a-random-hex-value
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
INGESTION_KEY_PEPPER=replace-with-an-independent-random-secret

# Optional OpenID Connect login. Register this callback at your identity provider:
# https://lens.example.com/api/auth/oauth2/callback/oidc
OIDC_ENABLED=false
OIDC_PROVIDER_ID=oidc
OIDC_DISPLAY_NAME=Company SSO
OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=lens
OIDC_CLIENT_SECRET=replace-with-the-oidc-client-secret
OIDC_SCOPES=openid profile email
OIDC_REQUIRE_ISSUER_VALIDATION=false
# New OIDC users can always join through a pending Lens invitation. To also admit everyone from
# selected verified email domains, enable auto-provisioning and list those domains here.
OIDC_AUTO_PROVISION=false
OIDC_ALLOWED_DOMAINS=example.com
# Keep this enabled until OIDC has been tested, so the owner has a recovery sign-in method.
PASSWORD_LOGIN_ENABLED=true

# Optional password-reset email. Leave SMTP_HOST, SMTP_USER, and SMTP_PASSWORD empty to disable it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Anvia Lens <lens@example.com>

OTLP_MAX_BODY_BYTES=10485760
OTLP_RATE_LIMIT_PER_MINUTE=600
MCP_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
