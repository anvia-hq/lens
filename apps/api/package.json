{
  "name": "@lens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.26",
    "@clickhouse/client": "^1.12.0",
    "@hono/node-server": "^2.1.0",
    "@lens/config": "workspace:*",
    "@lens/contracts": "workspace:*",
    "@lens/db": "workspace:*",
    "@lens/queue": "workspace:*",
    "@lens/telemetry": "workspace:*",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "ioredis": "^5.7.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.9.0",
    "prom-client": "^15.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
