{
  "name": "@lens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.33",
    "@clickhouse/client": "^1.24.1",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@lens/config": "workspace:*",
    "@lens/contracts": "workspace:*",
    "@lens/db": "workspace:*",
    "@lens/notifications": "workspace:*",
    "@lens/queue": "workspace:*",
    "@lens/telemetry": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "^1.6.33",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
