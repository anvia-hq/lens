{
  "name": "@lens/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lens/config": "workspace:*",
    "@lens/contracts": "workspace:*",
    "@lens/db": "workspace:*",
    "@lens/notifications": "workspace:*",
    "@lens/queue": "workspace:*",
    "bullmq": "^6.4.2",
    "drizzle-orm": "^0.45.4",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
