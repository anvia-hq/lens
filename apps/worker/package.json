{
  "name": "@lens/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lens/config": "workspace:*",
    "@lens/contracts": "workspace:*",
    "@lens/db": "workspace:*",
    "@lens/queue": "workspace:*",
    "bullmq": "^5.58.0",
    "drizzle-orm": "^0.44.0",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
