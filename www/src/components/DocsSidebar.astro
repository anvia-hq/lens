---
import { docsNavigation } from "../data/docs-navigation";

const path = Astro.url.pathname;
---

<aside class="min-w-0 border-b border-white/[0.08] md:border-r md:border-b-0">
  <details class="group block px-4 py-4 md:hidden">
    <summary class="cursor-pointer text-[0.8125rem] text-muted-foreground group-open:mb-4 group-open:text-foreground">
      Browse documentation
    </summary>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        docsNavigation.map((group) => (
          <section class="grid gap-1">
            <p class="mb-1.5 font-mono text-[0.68rem] tracking-[0.16em] text-zinc-500 uppercase">
              {group.label}
            </p>
            {group.links.map((link) => (
              <a
                class="block rounded-lg px-2.5 py-2 text-sm font-medium text-zinc-400 no-underline transition hover:bg-white/[0.045] hover:text-zinc-100 aria-[current=page]:bg-white/[0.055] aria-[current=page]:text-zinc-50"
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
          </section>
        ))
      }
    </div>
  </details>
  <nav
    class="sticky top-16 hidden max-h-[calc(100vh-4rem)] gap-8 overflow-y-auto px-6 py-7 md:grid"
    aria-label="Documentation navigation"
  >
    <div class="grid gap-7">
      {
        docsNavigation.map((group) => (
          <section class="grid gap-1">
            <p class="mb-1.5 font-mono text-[0.68rem] tracking-[0.16em] text-zinc-500 uppercase">
              {group.label}
            </p>
            {group.links.map((link) => (
              <a
                class="-mx-2.5 block rounded-lg px-2.5 py-2 text-sm font-medium text-zinc-400 no-underline transition hover:bg-white/[0.045] hover:text-zinc-100 aria-[current=page]:bg-white/[0.055] aria-[current=page]:text-zinc-50"
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
          </section>
        ))
      }
    </div>
  </nav>
</aside>
