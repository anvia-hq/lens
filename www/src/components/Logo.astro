---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a
  class="inline-flex items-center gap-2.5 text-foreground no-underline"
  href="/"
  aria-label="Anvia Lens documentation home"
>
  <svg class="size-[1.375rem] shrink-0 text-brand" aria-hidden="true" viewBox="0 0 24 24">
    <path
      d="M12 2.5c.58 5.17 4.33 8.92 9.5 9.5-5.17.58-8.92 4.33-9.5 9.5-.58-5.17-4.33-8.92-9.5-9.5 5.17-.58 8.92-4.33 9.5-9.5Z"
      fill="currentColor"
    ></path>
  </svg>
  {!compact && (
    <span class="flex items-center gap-2.5 text-sm">
      <strong class="font-mono font-semibold tracking-[-0.025em]">Anvia Lens</strong>
      <span class="h-4 w-px bg-border" aria-hidden="true" />
      <span class="text-muted-foreground">Docs</span>
    </span>
  )}
</a>
