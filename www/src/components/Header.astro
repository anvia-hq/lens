---
import Logo from "./Logo.astro";

interface Props {
  docs?: boolean;
  searchEnabled?: boolean;
}

const { docs = false, searchEnabled = false } = Astro.props;
---

<header
  class="sticky top-0 z-30 h-16 border-b border-white/10 bg-[#131314]/90 backdrop-blur-xl"
>
  <div
    class:list={[
      "flex h-full items-center justify-between gap-4 px-4 sm:px-6 lg:px-8",
      docs ? "w-full" : "mx-auto max-w-7xl",
    ]}
  >
    <Logo compact />
    <nav class="flex items-center gap-2.5" aria-label="Primary navigation">
      {
        searchEnabled ? (
          <div class="hidden sm:block" data-pf-theme="dark">
            <pagefind-modal-trigger placeholder="Search documentation" />
          </div>
        ) : null
      }
      <a
        class="hidden h-10 items-center px-2 text-sm font-medium text-zinc-400 transition hover:text-zinc-50 sm:inline-flex"
        href="/docs/">Documentation</a
      >
      <a
        class="inline-flex size-9 items-center justify-center text-zinc-400 transition hover:text-zinc-50"
        href="https://github.com/anvia-hq/lens"
        aria-label="Anvia Lens on GitHub"
      >
        <svg class="size-5 fill-current" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.02c-3.2.7-3.88-1.38-3.88-1.38-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.17c.98 0 1.94.13 2.86.39 2.19-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.15v3.03c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
        </svg>
      </a>
      <a
        class="inline-flex items-center justify-center rounded-lg border border-white/15 bg-[#1a1a1b] px-3 py-1.5 text-sm font-medium text-zinc-100 shadow-sm transition hover:border-white/25 hover:bg-[#202022]"
        href={docs ? "/docs/getting-started/" : "/docs/"}
      >
        Read docs
      </a>
    </nav>
  </div>
</header>
