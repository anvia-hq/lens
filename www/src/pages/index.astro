---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Anvia Lens"
  description="Documentation for self-hosted AI observability and evaluation with Anvia Lens."
>
  <main class="bg-[#131314]">
    <section class="relative isolate overflow-hidden">
      <div
        class="relative mx-auto flex max-w-7xl flex-col items-center px-4 pt-24 pb-20 text-center sm:px-6 sm:pt-28 lg:px-8 lg:pt-32 lg:pb-24"
      >
        <div class="mx-auto max-w-4xl">
          <h1
            class="text-5xl leading-[0.95] font-semibold tracking-[-0.02em] text-zinc-50 sm:text-6xl lg:text-7xl"
          >
            Understand every run.<br /><span class="text-brand">Improve the next one.</span>
          </h1>
          <p
            class="mx-auto mt-7 max-w-4xl text-balance text-lg leading-8 text-zinc-400 sm:text-xl"
          >
            Self-hosted observability and evaluation for teams building production AI agents.
          </p>
          <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a
              class="inline-flex items-center justify-center rounded-lg border border-white/30 bg-linear-to-b from-white to-zinc-200 px-4 py-2 text-sm font-semibold text-[#131314] outline-2 outline-offset-2 outline-white/20 transition hover:from-white hover:to-zinc-100 active:translate-y-px"
              href="/docs/getting-started/"
            >
              Get started
            </a>
            <a
              class="inline-flex items-center justify-center rounded-lg border border-white/15 bg-[#1a1a1b] px-4 py-2 text-sm font-medium text-zinc-100 shadow-sm transition hover:border-white/25 hover:bg-[#202022] active:translate-y-px"
              href="https://github.com/anvia-hq/lens"
            >
              View on GitHub
            </a>
          </div>
          <div class="mx-auto mt-16 flex max-w-3xl flex-wrap items-center justify-center gap-2.5">
            {
              ["OpenTelemetry native", "Self-hosted", "Anvia SDK", "Langfuse compatible"].map(
                (item) => (
                  <span class="rounded-full border border-white/[0.08] bg-white/[0.025] px-3.5 py-2 text-sm font-semibold text-zinc-400">
                    {item}
                  </span>
                ),
              )
            }
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <a
        class="mx-auto block max-w-7xl overflow-hidden rounded-2xl border border-white/[0.08] bg-[#0f0f0d] shadow-[0_32px_100px_rgba(0,0,0,0.32)] transition hover:border-white/[0.14]"
        href="/docs/observability/"
        aria-label="Explore the Anvia Lens dashboard"
      >
        <img
          class="block h-auto w-full"
          src="/images/docs/overview.png"
          alt="Anvia Lens dashboard showing trace activity, errors, latency, token usage, sessions, models, and services"
          loading="eager"
          decoding="async"
        />
      </a>
    </section>

    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="font-mono text-xs tracking-[0.18em] text-zinc-500 uppercase">Quick start</p>
          <h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-[-0.02em] text-zinc-100 sm:text-4xl">
            Run Lens on your own infrastructure.
          </h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-zinc-500">
            Start the complete stack with Docker Compose, then create your owner account and first
            project.
          </p>
          <div class="mt-6 flex w-fit max-w-full items-center overflow-hidden rounded-lg bg-white/[0.04]">
            <code class="overflow-x-auto px-4 py-3 font-mono text-sm text-brand">
              docker compose up -d
            </code>
            <a
              class="grid size-11 shrink-0 place-items-center border-l border-white/10 text-zinc-400 transition hover:bg-white/[0.06] hover:text-zinc-100"
              href="/docs/getting-started/"
              aria-label="Open installation guide"
            >
              →
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/[0.08] bg-[#101011] py-10">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-4 px-4 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
    >
      <p>© 2026 Anvia. Built for agent products.</p>
      <div class="flex gap-5">
        <a class="transition hover:text-zinc-300" href="/docs/">Docs</a>
        <a class="transition hover:text-zinc-300" href="https://github.com/anvia-hq/lens">
          GitHub
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
