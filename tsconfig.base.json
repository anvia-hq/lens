{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@lens/config": ["packages/config/src/index.ts"],
      "@lens/contracts": ["packages/contracts/src/index.ts"],
      "@lens/db": ["packages/db/src/index.ts"],
      "@lens/db/schema": ["packages/db/src/schema.ts"],
      "@lens/queue": ["packages/queue/src/index.ts"],
      "@lens/telemetry": ["packages/telemetry/src/index.ts"],
      "@lens/ui/*": ["packages/ui/src/*"],
      "@/*": ["apps/web/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true
  }
}
