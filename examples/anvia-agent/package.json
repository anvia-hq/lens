{
  "name": "@lens/example-anvia-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "basics": "pnpm basics:01",
    "basics:01": "tsx -r dotenv/config 01_basics/01-basic-tracing.ts dotenv_config_path=.env",
    "basics:02": "tsx -r dotenv/config 01_basics/02-trace-context.ts dotenv_config_path=.env",
    "tools": "pnpm tools:01",
    "tools:01": "tsx -r dotenv/config 02_tools/01-tool-tracing.ts dotenv_config_path=.env",
    "evaluations": "pnpm evaluations:01",
    "evaluations:01": "tsx -r dotenv/config 03_evaluations/01-evaluation-run.ts dotenv_config_path=.env",
    "evaluations:02": "tsx -r dotenv/config 03_evaluations/02-llm-judge.ts dotenv_config_path=.env",
    "evaluations:03": "tsx -r dotenv/config 03_evaluations/03-managed-dataset.ts dotenv_config_path=.env",
    "release": "pnpm release:01",
    "release:01": "tsx -r dotenv/config 04_release/01-compare-and-gate.ts dotenv_config_path=.env",
    "build": "tsup 01_basics/*.ts 02_tools/*.ts 03_evaluations/*.ts 04_release/*.ts --format esm --clean",
    "start": "pnpm basics:01",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anvia/core": "1.6.1",
    "@anvia/lens": "1.2.1",
    "@anvia/openai": "1.1.8",
    "dotenv": "^17.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
