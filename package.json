{
  "name": "lens",
  "version": "0.10.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "biome check .",
    "check:bundle": "node scripts/check-web-bundle.mjs",
    "check:fix": "biome check --write .",
    "dev": "pnpm --parallel --filter @lens/api --filter @lens/worker --filter @lens/web dev",
    "db:generate": "pnpm --filter @lens/db db:generate",
    "db:migrate": "pnpm --filter @lens/db db:migrate",
    "db:seed": "pnpm --filter @lens/db db:seed",
    "example:anvia": "pnpm --filter @lens/example-anvia-agent basics:01",
    "example:anvia:context": "pnpm --filter @lens/example-anvia-agent basics:02",
    "example:anvia:tools": "pnpm --filter @lens/example-anvia-agent tools:01",
    "example:anvia:eval": "pnpm --filter @lens/example-anvia-agent evaluations:01",
    "example:anvia:judge": "pnpm --filter @lens/example-anvia-agent evaluations:02",
    "example:anvia:dataset": "pnpm --filter @lens/example-anvia-agent evaluations:03",
    "example:anvia:release": "pnpm --filter @lens/example-anvia-agent release:01",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm --filter @lens/api --filter @lens/config --filter @lens/contracts --filter @lens/monitor --filter @lens/telemetry --filter @lens/ui --filter @lens/web --filter @lens/worker test:coverage && node scripts/run-package-integration-tests.mjs --coverage",
    "test:integration": "node scripts/run-package-integration-tests.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
